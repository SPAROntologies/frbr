    <owl:unionOf rdf:nodeID="n4a594ec2b6714efca9755f3c1a5a1a61b27"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4a594ec2b6714efca9755f3c1a5a1a61b28">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
