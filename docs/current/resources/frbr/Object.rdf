>
  <rdf:Description rdf:nodeID="n4a594ec2b6714efca9755f3c1a5a1a61b122">
    <rdf:first rdf:resource="http://purl.org/vocab/frbr/core#Event"/>
    <rdf:rest rdf:nodeID="n4a594ec2b6714efca9755f3c1a5a1a61b123"/>
