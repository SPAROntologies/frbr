    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-work a frbr:Work ;\n        frbr:subject :my-object .\n\n    :my-object a frbr:Object .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A material thing.\n"
      }
    ],
